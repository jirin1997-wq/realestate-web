{
  "name": "real-estate-scraper",
  "version": "0.1.0",
  "description": "Real estate scraper & analyzer for Czech properties (Praha + Brno)",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "node --test tests/*.test.js",
    "scrape": "node backend/cron.js --now",
    "scrape:all": "node backend/cron.js --now",
    "scrape:sreality": "node backend/scrapers/sreality.js",
    "scrape:idnes": "node backend/scrapers/idnes.js",
    "scrape:bezrealitky": "node backend/scrapers/bezrealitky.js",
    "scrape:developers": "node backend/scrapers/developers.js praha",
    "snapshot": "node backend/jobs/snapshot.js",
    "enrich": "node backend/jobs/enrich.js",
    "enrich:gps": "node backend/jobs/enrich-gps.js",
    "enrich:parallel": "node backend/jobs/enrich-parallel.js",
    "db:migrate": "knex migrate:latest --knexfile backend/db/knexfile.js",
    "db:rollback": "knex migrate:rollback --knexfile backend/db/knexfile.js",
    "db:seed": "knex seed:run --knexfile backend/db/knexfile.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "probe": "node backend/scrapers/probe.js",
    "discover": "node backend/scrapers/discover.js"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "knex": "^3.1.0",
    "node-schedule": "^2.1.1",
    "p-queue": "^9.3.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
